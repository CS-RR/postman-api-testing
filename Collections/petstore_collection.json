                  "\r",
                  "pm.test(\"Response body contains code 200\", function () {\r",
                  "    pm.expect(jsonData.code).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Deleted pet id is correct\", function () {\r",
