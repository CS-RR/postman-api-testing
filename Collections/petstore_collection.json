          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.response.json(); //convert JSON in an object Javascript\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Pet ID is correct\", function () {\r",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"pet_id\")));//read\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Pet name is correct\", function () {\r",
                  "    pm.expect(jsonData.name).to.eql(pm.iterationData.get(\"pet_name\"));\r",
                  "    //.to.eql(pm.environment.get(\"pet_name\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Pet status is correct\", function () {\r",
                  "    pm.expect(jsonData.status).to.eql(pm.iterationData.get(\"pet_status\"));\r",
                  "    //.to.eql(pm.environment.get(\"pet_status\"));\r",
                  "});\r",
                  "\r",
                  "//save variables\r",
                  "pm.environment.set(\"pet_id\",jsonData.id);\r",
                  "pm.environment.set(\"pet_name\",jsonData.name);\r",
                  "pm.environment.set(\"pet_status\",jsonData.status);\r",
                  "pm.environment.set(\"pet_id\", jsonData.id);\r",
                  "\r",
                  "console.log(\"Pet ID recibido:\", jsonData.id); //show\r",
                  "console.log(\"CSV:\", pm.iterationData.get(\"pet_name\"));\r",
                  "console.log(\"ENV:\", pm.environment.get(\"pet_name\"));\r",
                  "console.log(\"RESP:\", jsonData.name);"
                ],
